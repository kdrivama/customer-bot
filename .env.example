# Copy to .env for local dev. On Render, set these in the dashboard instead.

# Which API provides the customer's dialogue. Usually you do not need to set this:
# if DEEPSEEK_API_KEY is present it uses deepseek, otherwise openrouter.
#   deepseek    - paid per token, no daily request cap. ~$0.0002 per rephrase.
#   openrouter  - free models, but the free tier is capped at 50 requests per DAY
#                 for the whole account across every :free model combined.
AI_PROVIDER=deepseek

# Set the key for whichever provider you use. Leave both blank to run the simulator
# fully scripted, which is still a complete experience.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# How the AI is used:
#   rephrase  - scripted engine drives options/scoring, AI rewrites the customer's
#               line in character. Default. Keeps the trainer working.
#   off       - ignore the key entirely, pure scripted mode.
#   freeform  - AI answers directly with no options (original behaviour; the
#               multiple-choice trainer does not run in this mode).
AI_MODE=rephrase

# Models tried in order until one returns a usable line. Leave blank to use the
# provider's default: deepseek-chat for DeepSeek, or a chain of free slugs for
# OpenRouter (a chain, because any single free slug is often rate-limited upstream).
# Use deepseek-chat rather than deepseek-reasoner — the reasoner spends tokens
# thinking about what is only a one-line rewrite.
AI_MODELS=

# Give up on the chain after this long so a turn cannot hang on a busy provider.
AI_TOTAL_BUDGET_MS=25000

# Sent as HTTP-Referer to OpenRouter for usage attribution. Ignored by DeepSeek.
HTTP_REFERER=http://localhost:3000

# Max AI-backed chat turns per IP per hour, so a public embed can't drain credits.
# This is per real visitor IP; the app sets trust proxy so Render's load balancer
# address is not mistaken for everyone.
AI_RATE_LIMIT_PER_HOUR=60

PORT=3000
