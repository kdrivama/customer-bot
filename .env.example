# Copy to .env for local dev. On Render, set these in the dashboard instead.

# OpenRouter key. Leave blank to run the simulator fully scripted (no AI calls).
OPENROUTER_API_KEY=

# How the AI is used:
#   rephrase  - scripted engine drives options/scoring, AI rewrites the customer's
#               line in character. Default. Keeps the trainer working.
#   off       - ignore the key entirely, pure scripted mode.
#   freeform  - AI answers directly with no options (original behaviour; the
#               multiple-choice trainer does not run in this mode).
AI_MODE=rephrase

# Models tried in order until one returns a usable line. All free; the chain exists
# because any single free slug is regularly rate-limited upstream. Free slugs are
# also retired without notice — if the AI indicator goes grey and stays grey, check
# https://openrouter.ai/models?max_price=0 for current slugs and update this list.
# Not every free model is usable here: some are moderation or code models, and some
# leak their reasoning into the reply.
OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,poolside/laguna-s-2.1:free,nvidia/nemotron-3-ultra-550b-a55b:free,openai/gpt-oss-20b:free

# Give up on the chain after this long so a turn cannot hang on busy providers.
AI_TOTAL_BUDGET_MS=25000

# Sent as HTTP-Referer to OpenRouter. Set to your deployed URL in production.
HTTP_REFERER=http://localhost:3000

# Max AI-backed chat turns per IP per hour, so a public embed can't drain credits.
AI_RATE_LIMIT_PER_HOUR=60

PORT=3000
